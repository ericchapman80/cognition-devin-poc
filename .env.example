# =============================================================================
# AI Trading Agents - Environment Configuration
# =============================================================================
# Copy this file to .env and update values as needed:
#   cp .env.example .env
#
# This file controls which LLM provider the app uses, model names,
# API endpoints, and trading parameters. Both CLI and Streamlit read
# from .env (Streamlit sidebar defaults come from here too).

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Supported providers: ollama, lmstudio, openai
# - ollama: Local LLM via Ollama (default, free)
# - lmstudio: Local LLM via LM Studio (free, OpenAI-compatible API)
# - openai: OpenAI cloud API (requires API key)
# This determines which backend the agents call for inference.
LLM_PROVIDER=ollama

# LLM temperature (0.0 = deterministic, 1.0 = creative). Affects all agents.
LLM_TEMPERATURE=0.3

# -----------------------------------------------------------------------------
# Ollama (local) - https://ollama.com
# -----------------------------------------------------------------------------
# Install Ollama, then: ollama pull llama3
# No API key needed. The base URL is the Ollama server endpoint.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# -----------------------------------------------------------------------------
# LM Studio (local) - https://lmstudio.ai
# -----------------------------------------------------------------------------
# Download LM Studio, load any model, and start the local server.
# LM Studio exposes an OpenAI-compatible API at http://localhost:1234/v1.
# The model name is auto-detected by LM Studio (use "local-model" or the
# exact model identifier shown in LM Studio's server tab).
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# -----------------------------------------------------------------------------
# OpenAI (optional, cloud) - https://platform.openai.com
# -----------------------------------------------------------------------------
# Get your API key from: https://platform.openai.com/api-keys
# Only required if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# Trading Settings
# -----------------------------------------------------------------------------
# Risk tolerance: conservative, moderate, aggressive
# Affects position sizing recommendations and signal thresholds.
RISK_TOLERANCE=moderate

# Number of bull/bear debate rounds (1-5). More rounds = deeper analysis.
MAX_DEBATE_ROUNDS=2

# How many days of historical data to analyze (30-365).
ANALYSIS_PERIOD_DAYS=90

# -----------------------------------------------------------------------------
# Other providers (optional, reserved for future use)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# -----------------------------------------------------------------------------
# Alpha Vantage (optional, for additional market data)
# -----------------------------------------------------------------------------
# Get a free key from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
