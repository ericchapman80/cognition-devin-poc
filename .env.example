# LLM Provider Configuration
# Set the provider you want to use: ollama, openai, anthropic, google
LLM_PROVIDER=ollama

# Ollama (local) - no API key needed, just run: ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI (optional)
OPENAI_API_KEY=

# Anthropic (optional)
ANTHROPIC_API_KEY=

# Google Gemini (optional)
GOOGLE_API_KEY=

# Data Provider
# Alpha Vantage (optional, for additional data)
ALPHA_VANTAGE_API_KEY=
