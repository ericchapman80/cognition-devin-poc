# College Guide Multi-Agent Workflow - Environment Configuration
# Copy this file to .env and update values as needed.

# =============================================================================
# LLM Provider Configuration
# =============================================================================

# LLM provider to use: ollama, openai, or lmstudio
# - ollama: Local LLM via Ollama (default, free, requires Ollama installed)
# - openai: OpenAI API (requires API key, usage fees apply)
# - lmstudio: Local LLM via LM Studio (requires LM Studio running)
LLM_PROVIDER=ollama

# Model name to use with the selected provider
# - For ollama: llama3, mistral, codellama, etc.
# - For openai: gpt-4, gpt-3.5-turbo, etc.
# - For lmstudio: model name loaded in LM Studio
LLM_MODEL=llama3

# Temperature for LLM generation (0.0 = deterministic, 1.0 = creative)
# Lower values recommended for structured analysis tasks
LLM_TEMPERATURE=0.3

# =============================================================================
# Ollama Configuration (only needed if LLM_PROVIDER=ollama)
# =============================================================================

# Base URL for Ollama API
# Default: http://localhost:11434
# Change if Ollama is running on a different host/port
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# OpenAI Configuration (only needed if LLM_PROVIDER=openai)
# =============================================================================

# OpenAI API key - obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# =============================================================================
# College Guide Workflow Configuration
# =============================================================================

# Maximum number of review iterations before forcing report finalization
# The report reviewer agent will check quality up to this many times.
# Higher values = more thorough review but longer processing time.
# Range: 1-10, Default: 3
COLLEGE_GUIDE_MAX_REVIEWS=3

# Output directory for generated reports
# Reports will be saved as <StudentName>-College-Guide.md
COLLEGE_GUIDE_OUTPUT_DIR=./output
